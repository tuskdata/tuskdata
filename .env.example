# Copy to .env. Compose auto-loads it from this directory.
#   cp .env.example .env

# --- TuskData runtime ----------------------------------------------------
TUSK_DEBUG=0
TUSK_LOG_LEVEL=info            # debug | info | warning | error | critical
TUSK_LOG_FORMAT=console        # console (colored) | json (structured)
TUSK_QUERY_TIMEOUT=300
TUSK_PORT=8000
TUSK_HOST_PORT=7000
TZ=UTC

# --- Bundled tusk-cluster plugin ----------------------------------------
WITH_CLUSTER=1                 # 1 = bundle the plugin, 0 = skip
TUSK_CLUSTER_REF=v0.2.1

# --- tusk-cluster runtime (only with --profile cluster) -----------------
# Required when workers are reachable from outside the host. Generate:
#   openssl rand -hex 32
TUSK_CLUSTER_SECRET=
TUSK_CLUSTER_TLS=0

# --- Optional Postgres sidecar (only with --profile pg) ----------------
POSTGRES_USER=tusk
POSTGRES_PASSWORD=tusk
POSTGRES_DB=tusk

# --- Adminer (only with --profile dbtools) -----------------------------
ADMINER_HOST_PORT=8080
ADMINER_DEFAULT_SERVER=postgres

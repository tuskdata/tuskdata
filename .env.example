# Copy to .env and edit. Docker Compose auto-loads .env when you run from
# this directory.
#
#   cp .env.example .env
#   docker compose up --build

# --- Postgres ------------------------------------------------------------
POSTGRES_USER=tusk
POSTGRES_PASSWORD=tusk
POSTGRES_DB=tusk

# --- TuskData runtime ----------------------------------------------------
# 0 = production-ish defaults; 1 enables debug logs and disables some checks.
TUSK_DEBUG=0
# debug | info | warning | error | critical
TUSK_LOG_LEVEL=info
# console (colored) | json (structured, for log aggregators)
TUSK_LOG_FORMAT=console
# Per-query statement_timeout in seconds (Postgres only).
TUSK_QUERY_TIMEOUT=300
# Public port the Studio listens on inside the host.
TUSK_PORT=8000
# Time zone for log rendering only — internal timestamps are always UTC.
TZ=UTC

# --- tusk-cluster (only relevant with `--profile cluster`) --------------
# Shared secret required for worker→scheduler registration. Generate with:
#   openssl rand -hex 32
# Leave empty to disable the secret check (single-node dev).
TUSK_CLUSTER_SECRET=
# 1 = use grpc+tls:// for Flight; needs certs on workers + scheduler.
TUSK_CLUSTER_TLS=0

# --- Adminer (only relevant with `--profile dbtools`) -------------------
ADMINER_PORT=8080

# Copy to .env and edit. Compose auto-loads .env from this directory.
#   cp .env.example .env

# --- TuskData runtime ----------------------------------------------------
TUSK_DEBUG=0
TUSK_LOG_LEVEL=info            # debug | info | warning | error | critical
TUSK_LOG_FORMAT=console        # console (colored) | json (structured)
TUSK_QUERY_TIMEOUT=300         # statement_timeout in seconds (Postgres only)
TUSK_PORT=8000                 # internal listen port; usually leave alone
TUSK_HOST_PORT=7000            # what host port maps to the container's 8000
TZ=UTC                         # log rendering only — internal timestamps stay UTC

# --- Build pins (which plugin tag goes into this image) ------------------
# Bump these when you cut a new plugin release. The Dockerfile clones the
# plugin repos at these refs at image-build time.
TUSK_BI_REF=v0.2.1
TUSK_CI_REF=v0.2.0
TUSK_SEC_REF=v0.2.0
TUSK_CLUSTER_REF=v0.2.1
TUSK_PLUGINS_ORG=tuskdata

# How the Dockerfile authenticates when cloning plugin repos:
#   public  default — works only if every plugin repo is public on github
#   token   pass a PAT as build secret named gh_token (Coolify: Build Secrets)
#   ssh     forward your SSH agent (--ssh default) and configure deploy keys
TUSK_GIT_AUTH=public

# --- tusk-cluster (only with --profile cluster) -------------------------
# Required in any networked deployment. Generate with:
#   openssl rand -hex 32
TUSK_CLUSTER_SECRET=
TUSK_CLUSTER_TLS=0

# --- Optional local Postgres sidecar (only with --profile pg) -----------
# When you already have Postgres elsewhere (typical), don't enable this
# profile and just add the connection through the Studio UI.
POSTGRES_USER=tusk
POSTGRES_PASSWORD=tusk
POSTGRES_DB=tusk

# --- Adminer (only with --profile dbtools) ------------------------------
# Point ADMINER_DEFAULT_SERVER at whatever PG hostname you use.
ADMINER_HOST_PORT=8080
ADMINER_DEFAULT_SERVER=postgres
